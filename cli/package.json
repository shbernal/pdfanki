{
  "name": "@shbernal/pdfanki-cli",
  "version": "0.2.2",
  "description": "Create Anki decks from PDF and EPUB files using NLP with LLMs.",
  "keywords": [
    "anki",
    "pdf",
    "epub",
    "llm",
    "cli",
    "flashcards",
    "markdown",
    "nlp"
  ],
  "type": "module",
  "packageManager": "pnpm@11.4.0+sha512.f0febc7e37552ab485494a914241b338e0b3580b93d54ce31f00933015880863129038a1b4ae4e414a0ee63ac35bf21197e990172c4a68256450b5636310968f",
  "bin": {
    "pdfanki": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"const fs=require('fs');['dist','node_modules','tsconfig.tsbuildinfo'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}))\"",
    "dev": "tsx src/index.ts",
    "build": "tsc -b tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "test:live:codex": "node --test tests/liveCodexProviderCli.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint src --max-warnings 0"
  },
  "author": "shbernal <shbernal.01@gmail.com>",
  "homepage": "https://github.com/shbernal/pdfanki",
  "repository": {
    "type": "git",
    "url": "https://github.com/shbernal/pdfanki.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@shbernal/mdanki": "^1.1.5",
    "@shbernal/pdfanki": "workspace:^",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "tsx": "^4.23.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
