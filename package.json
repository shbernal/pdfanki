{
  "name": "pdfanki",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo build --output-logs=errors-only && oxlint --type-aware --deny-warnings",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "test:live:codex": "pnpm build && pnpm --dir cli test:live:codex",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "fetch-config-prompts": "./scripts/fetch-config-prompts",
    "cli-local-test": "./scripts/cli-local-test",
    "pdfanki-local": "env PDFANKI_LOCAL_DEV=1 PDFANKI_CALLER_CWD=\"$INIT_CWD\" pnpm --dir cli exec node --import tsx src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "lefthook": "^2.1.17",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
