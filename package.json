{
  "name": "pdfanki",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo build --output-logs=errors-only && oxlint --type-aware --deny-warnings",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "test:live:codex": "pnpm build && pnpm --dir cli test:live:codex",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "fetch-config-prompts": "./scripts/fetch-config-prompts",
    "cli-local-test": "./scripts/cli-local-test",
    "pdfanki-local": "env PDFANKI_LOCAL_DEV=1 PDFANKI_CALLER_CWD=\"$INIT_CWD\" pnpm --dir cli exec node --import tsx src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
