{
  "name": "pdfanki",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo build --output-logs=errors-only && oxlint --type-aware --deny-warnings",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "test:live:codex": "pnpm build && pnpm --dir cli test:live:codex",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "fetch-config-prompts": "./scripts/fetch-config-prompts",
    "cli-local-test": "./scripts/cli-local-test",
    "pdfanki-local": "env PDFANKI_LOCAL_DEV=1 PDFANKI_CALLER_CWD=\"$INIT_CWD\" pnpm --dir cli exec node --import tsx src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
