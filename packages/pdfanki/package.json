{
  "name": "@shbernal/pdfanki",
  "version": "0.2.1",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "description": "Create Anki decks from PDF and EPUB files using NLP with LLMs.",
  "keywords": [
    "anki",
    "pdf",
    "epub",
    "llm",
    "cli",
    "flashcards",
    "markdown",
    "nlp"
  ],
  "author": "shbernal <shbernal.01@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/shbernal/pdfanki",
  "repository": {
    "type": "git",
    "url": "https://github.com/shbernal/pdfanki.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('fs');['dist','node_modules','tsconfig.tsbuildinfo'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}))\"",
    "build": "tsc -b tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --list-different . | xargs -r prettier --write"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@google/genai": "^1.50.1",
    "epub": "^2.1.1",
    "openai": "^6.34.0",
    "pdf-parse": "^2.4.5"
  }
}
