{
  "name": "@shbernal/pdfanki",
  "version": "0.5.0",
  "description": "Create Anki decks from PDF and EPUB files using NLP with LLMs.",
  "keywords": [
    "anki",
    "cli",
    "epub",
    "flashcards",
    "llm",
    "markdown",
    "nlp",
    "pdf"
  ],
  "homepage": "https://github.com/shbernal/pdfanki",
  "license": "MIT",
  "author": "shbernal <shbernal.01@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/shbernal/pdfanki.git"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('fs');['dist','node_modules','tsconfig.tsbuildinfo'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}))\"",
    "build": "tsc -b tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@google/genai": "^2.21.0",
    "epub": "^2.1.1",
    "openai": "^7.10.0",
    "pdf-parse": "^2.4.5"
  },
  "engines": {
    "node": ">=24"
  }
}
